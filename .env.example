# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Step 2: Supabase (database and sign-in).
# Supabase dashboard > Project Settings > API Keys. Use the "Publishable" key
# (starts with sb_publishable_). It's safe in the browser; data is protected by
# the row-level security rules in supabase/migrations.
# NEVER put the "Secret" / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Price-drop notifications (free). Make the two VAPID keys with:
#   npx web-push generate-vapid-keys
# CRON_SECRET is any long random text. Vercel sends it to /api/price-alerts once a
# day; its SHA-256 fingerprint goes in the private.alert_key table (see 0014).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# Step 6: Anthropic API (shopping assistant), server side only
ANTHROPIC_API_KEY=
